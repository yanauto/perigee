{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": false,
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["src/cli/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["src/shared/slash-palette.ts", "src/**/*.test.ts"]
}
