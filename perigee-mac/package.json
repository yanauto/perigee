{
  "name": "perigee",
  "version": "0.1.0",
  "private": true,
  "description": "Perigee — Grok Build CLI 的原生 macOS 编排台",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @perigee/app dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "doctor": "bash scripts/doctor.sh",
    "gd:doctor": "bash scripts/doctor.sh",
    "lint": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
